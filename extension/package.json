{
  "name": "code-demo-typer",
  "displayName": "KeyStage",
  "description": "KeyStage · 键盘上的演示舞台。10 个快捷键预设、原位输入、缩进保留与删除重打。",
  "version": "1.2.1",
  "publisher": "local-demo",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "codeDemo.toggle",
        "title": "KeyStage：开启 / 暂停"
      },
      {
        "command": "codeDemo.new",
        "title": "KeyStage：设置预设内容"
      },
      {
        "command": "codeDemo.reset",
        "title": "KeyStage：从预设开头重新输入"
      },
      {
        "command": "codeDemo.stop",
        "title": "KeyStage：结束"
      },
      {
        "command": "codeDemo.preset1",
        "title": "KeyStage：启动预设 1"
      },
      {
        "command": "codeDemo.preset2",
        "title": "KeyStage：启动预设 2"
      },
      {
        "command": "codeDemo.preset3",
        "title": "KeyStage：启动预设 3"
      },
      {
        "command": "codeDemo.preset4",
        "title": "KeyStage：启动预设 4"
      },
      {
        "command": "codeDemo.preset5",
        "title": "KeyStage：启动预设 5"
      },
      {
        "command": "codeDemo.preset6",
        "title": "KeyStage：启动预设 6"
      },
      {
        "command": "codeDemo.preset7",
        "title": "KeyStage：启动预设 7"
      },
      {
        "command": "codeDemo.preset8",
        "title": "KeyStage：启动预设 8"
      },
      {
        "command": "codeDemo.preset9",
        "title": "KeyStage：启动预设 9"
      },
      {
        "command": "codeDemo.preset10",
        "title": "KeyStage：启动预设 10"
      }
    ],
    "keybindings": [
      {
        "command": "codeDemo.toggle",
        "key": "ctrl+alt+d",
        "mac": "cmd+alt+d"
      },
      {
        "command": "codeDemo.new",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r"
      },
      {
        "command": "codeDemo.reset",
        "key": "ctrl+alt+home",
        "mac": "cmd+alt+home"
      },
      {
        "command": "codeDemo.stop",
        "key": "escape",
        "when": "codeDemo.active && editorTextFocus"
      },
      {
        "command": "codeDemo.step",
        "key": "enter",
        "when": "codeDemo.active && editorTextFocus"
      },
      {
        "command": "codeDemo.step",
        "key": "tab",
        "when": "codeDemo.active && editorTextFocus"
      },
      {
        "command": "codeDemo.preset1",
        "key": "ctrl+alt+1",
        "mac": "cmd+alt+1",
        "when": "editorTextFocus"
      },
      {
        "command": "codeDemo.preset2",
        "key": "ctrl+alt+2",
        "mac": "cmd+alt+2",
        "when": "editorTextFocus"
      },
      {
        "command": "codeDemo.preset3",
        "key": "ctrl+alt+3",
        "mac": "cmd+alt+3",
        "when": "editorTextFocus"
      },
      {
        "command": "codeDemo.preset4",
        "key": "ctrl+alt+4",
        "mac": "cmd+alt+4",
        "when": "editorTextFocus"
      },
      {
        "command": "codeDemo.preset5",
        "key": "ctrl+alt+5",
        "mac": "cmd+alt+5",
        "when": "editorTextFocus"
      },
      {
        "command": "codeDemo.preset6",
        "key": "ctrl+alt+6",
        "mac": "cmd+alt+6",
        "when": "editorTextFocus"
      },
      {
        "command": "codeDemo.preset7",
        "key": "ctrl+alt+7",
        "mac": "cmd+alt+7",
        "when": "editorTextFocus"
      },
      {
        "command": "codeDemo.preset8",
        "key": "ctrl+alt+8",
        "mac": "cmd+alt+8",
        "when": "editorTextFocus"
      },
      {
        "command": "codeDemo.preset9",
        "key": "ctrl+alt+9",
        "mac": "cmd+alt+9",
        "when": "editorTextFocus"
      },
      {
        "command": "codeDemo.preset10",
        "key": "ctrl+alt+0",
        "mac": "cmd+alt+0",
        "when": "editorTextFocus"
      }
    ]
  },
  "license": "MIT",
  "keywords": [
    "demo",
    "typing",
    "presentation",
    "python",
    "snippets"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/LaoQiTX/keystage.git"
  },
  "homepage": "https://github.com/LaoQiTX/keystage#readme",
  "bugs": {
    "url": "https://github.com/LaoQiTX/keystage/issues"
  }
}
